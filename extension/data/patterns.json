{
  "version": "1.0.0",
  "patterns": [
    {
      "id": "fear_001",
      "category": "fear_urgency",
      "type": "regex",
      "pattern": "they don'?t want you to (know|see|hear)",
      "flags": "i",
      "severity": 4,
      "description": "Classic fear-based framing implying suppressed information",
      "bingoLabel": "They Don't Want You to Know"
    },
    {
      "id": "fear_002",
      "category": "fear_urgency",
      "type": "regex",
      "pattern": "wake up,? (people|america|sheeple|world)",
      "flags": "i",
      "severity": 3,
      "description": "Condescending call-to-action implying others are asleep to hidden truths",
      "bingoLabel": "Wake Up Sheeple"
    },
    {
      "id": "fear_003",
      "category": "fear_urgency",
      "type": "regex",
      "pattern": "before it'?s too late",
      "flags": "i",
      "severity": 3,
      "description": "Artificial urgency designed to prevent critical thinking",
      "bingoLabel": "Before It's Too Late"
    },
    {
      "id": "fear_004",
      "category": "fear_urgency",
      "type": "regex",
      "pattern": "this is (extremely |very |incredibly )?dangerous",
      "flags": "i",
      "severity": 3,
      "description": "Vague danger framing without substantiation",
      "bingoLabel": "This Is Dangerous"
    },
    {
      "id": "fear_005",
      "category": "fear_urgency",
      "type": "regex",
      "pattern": "share (this|now) before (it'?s|they) (deleted|removed|banned|taken down)",
      "flags": "i",
      "severity": 5,
      "description": "Manufactured urgency claiming content will be suppressed",
      "bingoLabel": "Share Before Deleted"
    },

    {
      "id": "ad_hom_001",
      "category": "ad_hominem",
      "type": "keyword",
      "pattern": "liberal snowflake",
      "flags": "i",
      "severity": 3,
      "description": "Dismissive label targeting political affiliation instead of argument",
      "bingoLabel": "Liberal Snowflake"
    },
    {
      "id": "ad_hom_002",
      "category": "ad_hominem",
      "type": "keyword",
      "pattern": "right-wing nut",
      "flags": "i",
      "severity": 3,
      "description": "Dismissive label targeting political affiliation instead of argument",
      "bingoLabel": "Right-Wing Nut"
    },
    {
      "id": "ad_hom_003",
      "category": "ad_hominem",
      "type": "keyword",
      "pattern": "libtard",
      "flags": "i",
      "severity": 4,
      "description": "Derogatory portmanteau used to dismiss opposing viewpoints",
      "bingoLabel": "Libtard"
    },
    {
      "id": "ad_hom_004",
      "category": "ad_hominem",
      "type": "regex",
      "pattern": "\\bsheep\\b(?! dog| wool| farm| herding)",
      "flags": "i",
      "severity": 2,
      "description": "Calling people sheep as an insult implying they blindly follow",
      "bingoLabel": "Calling People Sheep"
    },
    {
      "id": "ad_hom_005",
      "category": "ad_hominem",
      "type": "regex",
      "pattern": "(fake|lying|corrupt) (news media|mainstream media|journalists?|reporters?)",
      "flags": "i",
      "severity": 3,
      "description": "Blanket dismissal of media sources rather than engaging with content",
      "bingoLabel": "Fake/Corrupt Media"
    },

    {
      "id": "authority_001",
      "category": "appeal_to_authority",
      "type": "regex",
      "pattern": "experts? (agree|say|confirm|warn)",
      "flags": "i",
      "severity": 2,
      "description": "Vague appeal to unnamed experts without citations",
      "bingoLabel": "Experts Agree"
    },
    {
      "id": "authority_002",
      "category": "appeal_to_authority",
      "type": "regex",
      "pattern": "scientists? (say|confirm|prove|warn|reveal)",
      "flags": "i",
      "severity": 2,
      "description": "Vague appeal to unnamed scientists without citations",
      "bingoLabel": "Scientists Say"
    },
    {
      "id": "authority_003",
      "category": "appeal_to_authority",
      "type": "regex",
      "pattern": "studies (show|prove|confirm|reveal|suggest)",
      "flags": "i",
      "severity": 2,
      "description": "Reference to unspecified studies without citations",
      "bingoLabel": "Studies Show"
    },
    {
      "id": "authority_004",
      "category": "appeal_to_authority",
      "type": "regex",
      "pattern": "research (proves?|shows?|confirms?|reveals?)",
      "flags": "i",
      "severity": 2,
      "description": "Vague reference to research without citation",
      "bingoLabel": "Research Proves"
    },
    {
      "id": "authority_005",
      "category": "appeal_to_authority",
      "type": "regex",
      "pattern": "doctors? (warn|say|confirm|recommend)",
      "flags": "i",
      "severity": 2,
      "description": "Vague appeal to unnamed doctors without citations",
      "bingoLabel": "Doctors Warn"
    },

    {
      "id": "dichotomy_001",
      "category": "false_dichotomy",
      "type": "regex",
      "pattern": "you'?re either with us or (against|with) (us|them)",
      "flags": "i",
      "severity": 4,
      "description": "Classic false binary forcing a choice between two extremes",
      "bingoLabel": "With Us or Against Us"
    },
    {
      "id": "dichotomy_002",
      "category": "false_dichotomy",
      "type": "regex",
      "pattern": "there are only (two|2) (options?|choices?|sides?|ways?)",
      "flags": "i",
      "severity": 4,
      "description": "Explicitly limiting perceived options to a false binary",
      "bingoLabel": "Only Two Choices"
    },
    {
      "id": "dichotomy_003",
      "category": "false_dichotomy",
      "type": "regex",
      "pattern": "if you'?re not .{1,40}?, you'?re",
      "flags": "i",
      "severity": 3,
      "description": "Conditional framing that creates a false binary",
      "bingoLabel": "If You're Not X, You're Y"
    },
    {
      "id": "dichotomy_004",
      "category": "false_dichotomy",
      "type": "regex",
      "pattern": "it'?s (either|simply) (this|that|one) or (the other|that|another)",
      "flags": "i",
      "severity": 3,
      "description": "Simplistic either/or framing that ignores nuance",
      "bingoLabel": "Either/Or Framing"
    },
    {
      "id": "dichotomy_005",
      "category": "false_dichotomy",
      "type": "regex",
      "pattern": "you'?re (either|either a) (part of the (problem|solution)|with (us|them)|against (us|them))",
      "flags": "i",
      "severity": 3,
      "description": "Forces alignment with one side or implies complicity",
      "bingoLabel": "Part of Problem or Solution"
    },

    {
      "id": "emotional_001",
      "category": "emotional_manipulation",
      "type": "regex",
      "pattern": "([A-Z]{2,}\\s+){3,}[A-Z]{2,}",
      "flags": "",
      "severity": 2,
      "description": "Three or more consecutive fully uppercase words indicating shouting",
      "bingoLabel": "ALL CAPS SHOUTING"
    },
    {
      "id": "emotional_002",
      "category": "emotional_manipulation",
      "type": "regex",
      "pattern": "[!?]{3,}",
      "flags": "",
      "severity": 2,
      "description": "Excessive punctuation indicating emotional manipulation",
      "bingoLabel": "Excessive Punctuation!!!"
    },
    {
      "id": "emotional_003",
      "category": "emotional_manipulation",
      "type": "regex",
      "pattern": "think of the children",
      "flags": "i",
      "severity": 3,
      "description": "Appeal to emotion using children to short-circuit rational debate",
      "bingoLabel": "Think of the Children"
    },
    {
      "id": "emotional_004",
      "category": "emotional_manipulation",
      "type": "regex",
      "pattern": "if (this|it) doesn'?t (make you|anger|outrage|shock|scare) (you|angry|mad|furious)",
      "flags": "i",
      "severity": 4,
      "description": "Telling the reader how they should feel to manipulate response",
      "bingoLabel": "If This Doesn't Anger You"
    },
    {
      "id": "emotional_005",
      "category": "emotional_manipulation",
      "type": "regex",
      "pattern": "this (will|should) (make you|leave you) (sick|furious|angry|outraged|shocked|speechless)",
      "flags": "i",
      "severity": 3,
      "description": "Priming emotional response before presenting information",
      "bingoLabel": "This Will Make You Furious"
    },

    {
      "id": "weasel_001",
      "category": "weasel_words",
      "type": "regex",
      "pattern": "some people (say|claim|believe|think|argue)",
      "flags": "i",
      "severity": 3,
      "description": "Vague attribution to unnamed 'some people' to avoid accountability",
      "bingoLabel": "Some People Say"
    },
    {
      "id": "weasel_002",
      "category": "weasel_words",
      "type": "regex",
      "pattern": "many (people )?(believe|think|say|feel|claim)",
      "flags": "i",
      "severity": 2,
      "description": "Vague appeal to unnamed majority opinion",
      "bingoLabel": "Many Believe"
    },
    {
      "id": "weasel_003",
      "category": "weasel_words",
      "type": "phrase",
      "pattern": "it is well known",
      "flags": "i",
      "severity": 3,
      "description": "Asserting something as common knowledge to avoid providing evidence",
      "bingoLabel": "It Is Well Known"
    },
    {
      "id": "weasel_004",
      "category": "weasel_words",
      "type": "phrase",
      "pattern": "everyone knows",
      "flags": "i",
      "severity": 3,
      "description": "Asserting universal knowledge to bypass need for evidence",
      "bingoLabel": "Everyone Knows"
    },
    {
      "id": "weasel_005",
      "category": "weasel_words",
      "type": "regex",
      "pattern": "(anonymous |unnamed |unidentified )?sources? (say|claim|confirm|report|reveal)",
      "flags": "i",
      "severity": 3,
      "description": "Attribution to unverifiable sources",
      "bingoLabel": "Sources Say"
    },

    {
      "id": "conspiracy_001",
      "category": "conspiracy_markers",
      "type": "phrase",
      "pattern": "follow the money",
      "flags": "i",
      "severity": 3,
      "description": "Implies hidden financial motives without evidence",
      "bingoLabel": "Follow the Money"
    },
    {
      "id": "conspiracy_002",
      "category": "conspiracy_markers",
      "type": "phrase",
      "pattern": "do your own research",
      "flags": "i",
      "severity": 4,
      "description": "Deflects from providing evidence and implies mainstream sources are untrustworthy",
      "bingoLabel": "Do Your Own Research"
    },
    {
      "id": "conspiracy_003",
      "category": "conspiracy_markers",
      "type": "phrase",
      "pattern": "open your eyes",
      "flags": "i",
      "severity": 3,
      "description": "Implies listener is naive or willfully blind",
      "bingoLabel": "Open Your Eyes"
    },
    {
      "id": "conspiracy_004",
      "category": "conspiracy_markers",
      "type": "phrase",
      "pattern": "connect the dots",
      "flags": "i",
      "severity": 2,
      "description": "Suggests a pattern exists without providing logical proof",
      "bingoLabel": "Connect the Dots"
    },
    {
      "id": "conspiracy_005",
      "category": "conspiracy_markers",
      "type": "regex",
      "pattern": "the (mainstream|lamestream|corporate) media",
      "flags": "i",
      "severity": 3,
      "description": "Blanket dismissal of mainstream media as inherently untrustworthy",
      "bingoLabel": "The Mainstream Media"
    },

    {
      "id": "clickbait_001",
      "category": "clickbait",
      "type": "regex",
      "pattern": "shocking (truth|secret|revelation|confession|admission)",
      "flags": "i",
      "severity": 3,
      "description": "Sensationalist framing designed to generate clicks over inform",
      "bingoLabel": "Shocking Truth"
    },
    {
      "id": "clickbait_002",
      "category": "clickbait",
      "type": "regex",
      "pattern": "you won'?t believe (what|how|why|who|where|this)",
      "flags": "i",
      "severity": 3,
      "description": "Clickbait hook designed to exploit curiosity without informing",
      "bingoLabel": "You Won't Believe"
    },
    {
      "id": "clickbait_003",
      "category": "clickbait",
      "type": "regex",
      "pattern": "what .{1,30}? doesn'?t want you to (know|see|hear|find out)",
      "flags": "i",
      "severity": 4,
      "description": "Implies suppressed information to drive clicks",
      "bingoLabel": "What X Doesn't Want You to Know"
    },
    {
      "id": "clickbait_004",
      "category": "clickbait",
      "type": "regex",
      "pattern": "number \\d+ will (shock|surprise|amaze|blow your mind|leave you speechless)",
      "flags": "i",
      "severity": 3,
      "description": "Listicle clickbait promising emotional reaction",
      "bingoLabel": "Number X Will Shock You"
    },
    {
      "id": "clickbait_005",
      "category": "clickbait",
      "type": "regex",
      "pattern": "the (real |hidden |secret |untold )truth (about|behind|of)",
      "flags": "i",
      "severity": 3,
      "description": "Implies mainstream narrative is false and a hidden truth exists",
      "bingoLabel": "The Real/Hidden Truth"
    },

    {
      "id": "cherry_001",
      "category": "cherry_picking",
      "type": "ai_required",
      "pattern": "cherry_picking_stats",
      "severity": 4,
      "description": "Selective use of statistics or data points to support a predetermined conclusion while ignoring contradicting evidence",
      "bingoLabel": "Cherry-Picked Stats"
    },
    {
      "id": "cherry_002",
      "category": "cherry_picking",
      "type": "ai_required",
      "pattern": "selective_quotes",
      "severity": 3,
      "description": "Quoting a source out of context or using only the portion that supports the argument",
      "bingoLabel": "Out-of-Context Quote"
    },
    {
      "id": "cherry_003",
      "category": "cherry_picking",
      "type": "ai_required",
      "pattern": "misleading_comparison",
      "severity": 3,
      "description": "Comparing unlike things or using an unrepresentative sample to draw broad conclusions",
      "bingoLabel": "Misleading Comparison"
    },

    {
      "id": "fallacy_001",
      "category": "logical_fallacy",
      "type": "ai_required",
      "pattern": "straw_man",
      "severity": 4,
      "description": "Misrepresenting someone's argument to make it easier to attack",
      "bingoLabel": "Straw Man"
    },
    {
      "id": "fallacy_002",
      "category": "logical_fallacy",
      "type": "ai_required",
      "pattern": "slippery_slope",
      "severity": 3,
      "description": "Claiming one event will inevitably lead to extreme consequences without evidence",
      "bingoLabel": "Slippery Slope"
    },
    {
      "id": "fallacy_003",
      "category": "logical_fallacy",
      "type": "ai_required",
      "pattern": "whataboutism",
      "severity": 4,
      "description": "Deflecting criticism by pointing to unrelated wrongdoing elsewhere",
      "bingoLabel": "Whataboutism"
    },
    {
      "id": "fallacy_004",
      "category": "logical_fallacy",
      "type": "ai_required",
      "pattern": "circular_reasoning",
      "severity": 3,
      "description": "Using the conclusion as a premise in the argument",
      "bingoLabel": "Circular Reasoning"
    }
  ]
}
